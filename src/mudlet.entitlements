<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Applied when a release build is signed with the hardened runtime, which
     refuses the microphone to an app without audio-input - whatever the
     player allows in Privacy & Security - so speech-to-text could never
     listen. Signed by Mudlet/installers' make-installer.sh. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
