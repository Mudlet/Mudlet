{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "variant",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (Ninja)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug-asan",
      "displayName": "macOS Debug, AddressSanitizer",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "macos-debug-tsan",
      "displayName": "macOS Debug, ThreadSanitizer",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "thread"
      }
    },
    {
      "name": "macos-debug-ubsan",
      "displayName": "macOS Debug, UndefinedBehaviorSanitizer",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "macos-static-analysis",
      "displayName": "macOS Debug with clang-tidy and cppcheck",
      "inherits": ["variant", "macos-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux Debug, AddressSanitizer",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "linux-debug-tsan",
      "displayName": "Linux Debug, ThreadSanitizer",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "thread"
      }
    },
    {
      "name": "linux-debug-ubsan",
      "displayName": "Linux Debug, UndefinedBehaviorSanitizer",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "linux-static-analysis",
      "displayName": "Linux Debug with clang-tidy and cppcheck",
      "inherits": ["variant", "linux-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-lowspec",
      "displayName": "Linux Debug for low-memory machines (Raspberry Pi and similar)",
      "inherits": ["variant", "linux-debug"],
      "cacheVariables": {
        "USE_SANITIZER": "",
        "USE_UPDATER": "OFF",
        "USE_3DMAPPER": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSYS2, Ninja)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MSYSTEM_PREFIX}"
      }
    },
    {
      "name": "windows-debug-ubsan",
      "displayName": "Windows Debug, UndefinedBehaviorSanitizer",
      "inherits": ["variant", "windows-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "freebsd-debug",
      "displayName": "FreeBSD Debug (Ninja)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      }
    },
    {
      "name": "freebsd-debug-asan",
      "displayName": "Freebsd Debug, AddressSanitizer",
      "inherits": ["variant", "freebsd-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "freebsd-debug-tsan",
      "displayName": "Freebsd Debug, ThreadSanitizer",
      "inherits": ["variant", "freebsd-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "thread"
      }
    },
    {
      "name": "freebsd-debug-ubsan",
      "displayName": "Freebsd Debug, UndefinedBehaviorSanitizer",
      "inherits": ["variant", "freebsd-debug"],
      "environment": {
        "USE_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "freebsd-static-analysis",
      "displayName": "Freebsd Debug with clang-tidy and cppcheck",
      "inherits": ["variant", "freebsd-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "on-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "on-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "on-freebsd",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      }
    },
    { "name": "macos-debug", "inherits": "on-macos", "configurePreset": "macos-debug" },
    { "name": "macos-debug-asan", "inherits": "on-macos", "configurePreset": "macos-debug-asan" },
    { "name": "macos-debug-tsan", "inherits": "on-macos", "configurePreset": "macos-debug-tsan" },
    { "name": "macos-debug-ubsan", "inherits": "on-macos", "configurePreset": "macos-debug-ubsan" },
    { "name": "macos-static-analysis", "inherits": "on-macos", "configurePreset": "macos-static-analysis" },
    { "name": "linux-debug", "inherits": "on-linux", "configurePreset": "linux-debug" },
    { "name": "linux-debug-asan", "inherits": "on-linux", "configurePreset": "linux-debug-asan" },
    { "name": "linux-debug-tsan", "inherits": "on-linux", "configurePreset": "linux-debug-tsan" },
    { "name": "linux-debug-ubsan", "inherits": "on-linux", "configurePreset": "linux-debug-ubsan" },
    { "name": "linux-static-analysis", "inherits": "on-linux", "configurePreset": "linux-static-analysis" },
    { "name": "linux-lowspec", "inherits": "on-linux", "configurePreset": "linux-lowspec", "jobs": 2 },
    { "name": "freebsd-debug", "inherits": "on-freebsd", "configurePreset": "freebsd-debug" },
    { "name": "freebsd-debug-asan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-asan" },
    { "name": "freebsd-debug-tsan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-tsan" },
    { "name": "freebsd-debug-ubsan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-ubsan" },
    { "name": "freebsd-static-analysis", "inherits": "on-freebsd", "configurePreset": "freebsd-static-analysis" },
    { "name": "windows-debug", "configurePreset": "windows-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "on-macos",
      "hidden": true,
      "inherits": "test-defaults",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "on-linux",
      "hidden": true,
      "inherits": "test-defaults",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "on-freebsd",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "FreeBSD"
      }
    },
    { "name": "macos-debug", "inherits": "on-macos", "configurePreset": "macos-debug" },
    { "name": "macos-debug-asan", "inherits": "on-macos", "configurePreset": "macos-debug-asan" },
    { "name": "macos-debug-tsan", "inherits": "on-macos", "configurePreset": "macos-debug-tsan" },
    { "name": "macos-debug-ubsan", "inherits": "on-macos", "configurePreset": "macos-debug-ubsan" },
    { "name": "macos-static-analysis", "inherits": "on-macos", "configurePreset": "macos-static-analysis" },
    { "name": "linux-debug", "inherits": "on-linux", "configurePreset": "linux-debug" },
    { "name": "linux-debug-asan", "inherits": "on-linux", "configurePreset": "linux-debug-asan" },
    { "name": "linux-debug-tsan", "inherits": "on-linux", "configurePreset": "linux-debug-tsan" },
    { "name": "linux-debug-ubsan", "inherits": "on-linux", "configurePreset": "linux-debug-ubsan" },
    { "name": "linux-static-analysis", "inherits": "on-linux", "configurePreset": "linux-static-analysis" },
    { "name": "linux-lowspec", "inherits": "on-linux", "configurePreset": "linux-lowspec" },
    { "name": "freebsd-debug", "inherits": "on-freebsd", "configurePreset": "freebsd-debug" },
    { "name": "freebsd-debug-asan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-asan" },
    { "name": "freebsd-debug-tsan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-tsan" },
    { "name": "freebsd-debug-ubsan", "inherits": "on-freebsd", "configurePreset": "freebsd-debug-ubsan" },
    { "name": "freebsd-static-analysis", "inherits": "on-freebsd", "configurePreset": "freebsd-static-analysis" },
    {
      "name": "windows-debug",
      "inherits": "test-defaults",
      "configurePreset": "windows-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}
