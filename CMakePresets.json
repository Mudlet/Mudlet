{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "variant",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (Ninja, No sanitizers)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_VERBOSE_MAKEFILE": "ON"
      }
    },
    {
      "name": "macos-debug-asan",
      "displayName": "macOS Debug (Address Sanitizer)",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "macos-debug-tsan",
      "displayName": "macOS Debug (Thread Sanitizer)",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "thread"
      }
    },
    {
      "name": "macos-debug-ubsan",
      "displayName": "macOS Debug (Undefined Behavior Sanitizer)",
      "inherits": ["variant", "macos-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "macos-static-analysis",
      "displayName": "macOS Debug (Clang-tidy and cppcheck)",
      "inherits": ["variant", "macos-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja, No sanitizers)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_VERBOSE_MAKEFILE": "ON"
      }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux Debug (Address Sanitizer)",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "linux-debug-tsan",
      "displayName": "Linux Debug (Thread Sanitizer)",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "thread"
      }
    },
    {
      "name": "linux-debug-ubsan",
      "displayName": "Linux Debug (Undefined Behavior Sanitizer)",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "linux-static-analysis",
      "displayName": "Linux Debug (Clang-tidy and cppcheck)",
      "inherits": ["variant", "linux-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "linux-lowspec",
      "displayName": "Linux Debug for low-memory machines (Raspberry Pi and similar)",
      "inherits": ["variant", "linux-debug"],
      "environment": {
        "WITH_SANITIZERS": "NO",
        "WITH_UPDATER": "NO",
        "WITH_3DMAPPER": "NO"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (Ninja, No sanitizer)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MSYSTEM_PREFIX}",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_VERBOSE_MAKEFILE": "ON"
      }
    },
    {
      "name": "windows-debug-asan",
      "displayName": "Windows Debug (Address Sanitizer)",
      "inherits": ["variant", "windows-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "address"
      }
    },
    {
      "name": "windows-debug-ubsan",
      "displayName": "Windows Debug (Undefined Behavior Sanitizer)",
      "inherits": ["variant", "windows-debug"],
      "environment": {
        "WITH_SANITIZERS": "YES",
        "MUDLET_SANITIZERS": "undefined"
      }
    },
    {
      "name": "windows-static-analysis",
      "displayName": "Windows Debug (Clang-tidy and cppcheck)",
      "inherits": ["variant", "windows-debug"],
      "cacheVariables": {
        "ENABLE_STATIC_ANALYSIS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "on-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "on-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "on-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    { "name": "macos-debug", "inherits": "on-macos", "configurePreset": "macos-debug" },
    { "name": "macos-debug-asan", "inherits": "on-macos", "configurePreset": "macos-debug-asan" },
    { "name": "macos-debug-tsan", "inherits": "on-macos", "configurePreset": "macos-debug-tsan" },
    { "name": "macos-debug-ubsan", "inherits": "on-macos", "configurePreset": "macos-debug-ubsan" },
    { "name": "macos-static-analysis", "inherits": "on-macos", "configurePreset": "macos-static-analysis" },
    { "name": "linux-debug", "inherits": "on-linux", "configurePreset": "linux-debug" },
    { "name": "linux-debug-asan", "inherits": "on-linux", "configurePreset": "linux-debug-asan" },
    { "name": "linux-debug-tsan", "inherits": "on-linux", "configurePreset": "linux-debug-tsan" },
    { "name": "linux-debug-ubsan", "inherits": "on-linux", "configurePreset": "linux-debug-ubsan" },
    { "name": "linux-static-analysis", "inherits": "on-linux", "configurePreset": "linux-static-analysis" },
    { "name": "linux-lowspec", "inherits": "on-linux", "configurePreset": "linux-lowspec", "jobs": 2 },
    { "name": "windows-debug", "inherits": "on-windows", "configurePreset": "windows-debug"},
    { "name": "windows-debug-asan", "inherits": "on-windows", "configurePreset": "windows-debug-asan"},
    { "name": "windows-debug-ubsan", "inherits": "on-windows", "configurePreset": "windows-debug-ubsan"},
    { "name": "windows-static-analysis", "inherits": "on-windows", "configurePreset": "windows-static-analysis"}
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "on-macos",
      "hidden": true,
      "inherits": "test-defaults",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "on-linux",
      "hidden": true,
      "inherits": "test-defaults",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    } ,
    {
      "name": "on-windows",
      "hidden": true,
      "inherits": "test-defaults",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    { "name": "macos-debug", "inherits": "on-macos", "configurePreset": "macos-debug" },
    { "name": "macos-debug-asan", "inherits": "on-macos", "configurePreset": "macos-debug-asan" },
    { "name": "macos-debug-tsan", "inherits": "on-macos", "configurePreset": "macos-debug-tsan" },
    { "name": "macos-debug-ubsan", "inherits": "on-macos", "configurePreset": "macos-debug-ubsan" },
    { "name": "macos-static-analysis", "inherits": "on-macos", "configurePreset": "macos-static-analysis" },
    { "name": "linux-debug", "inherits": "on-linux", "configurePreset": "linux-debug" },
    { "name": "linux-debug-asan", "inherits": "on-linux", "configurePreset": "linux-debug-asan" },
    { "name": "linux-debug-tsan", "inherits": "on-linux", "configurePreset": "linux-debug-tsan" },
    { "name": "linux-debug-ubsan", "inherits": "on-linux", "configurePreset": "linux-debug-ubsan" },
    { "name": "linux-static-analysis", "inherits": "on-linux", "configurePreset": "linux-static-analysis" },
    { "name": "linux-lowspec", "inherits": "on-linux", "configurePreset": "linux-lowspec" },
    { "name": "windows-debug", "inherits": "on-windows", "configurePreset": "windows-debug"},
    { "name": "windows-debug-asan", "inherits": "on-windows", "configurePreset": "windows-debug-asan"},
    { "name": "windows-debug-ubsan", "inherits": "on-windows", "configurePreset": "windows-debug-ubsan"},
    { "name": "windows-static-analysis", "inherits": "on-windows", "configurePreset": "windows-static-analysis"}
  ]
}
